<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Ikon Peringatan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textColor="#FFFFFF"
            android:textSize="70sp"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="20dp" />

        <!-- Judul: DEVICE LOCKED -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEVICE LOCKED"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp" />

        <!-- Pesan Custom -->
        <TextView
            android:id="@+id/tv_pesan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PESAN CUSTOM"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Timer / Permanen (Nanti diubah lewat Java) -->
        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIBUKA DALAM : 00:59:59"
            android:textColor="#888888"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="40dp" />

        <!-- Kotak PIN (Abu-abu gelap) -->
        <TextView
            android:id="@+id/tv_pin_display"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#333333"
            android:text="*"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.5"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Keypad -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_marginBottom="20dp">

            <Button android:text="1" style="@style/KeypadButton" />
            <Button android:text="2" style="@style/KeypadButton" />
            <Button android:text="3" style="@style/KeypadButton" />
            <Button android:text="4" style="@style/KeypadButton" />
            <Button android:text="5" style="@style/KeypadButton" />
            <Button android:text="6" style="@style/KeypadButton" />
            <Button android:text="7" style="@style/KeypadButton" />
            <Button android:text="8" style="@style/KeypadButton" />
            <Button android:text="9" style="@style/KeypadButton" />
            
            <!-- Baris Bawah -->
            <Button android:text="" style="@style/KeypadButton" android:visibility="invisible"/>
            <Button android:text="0" style="@style/KeypadButton" />
            <Button android:text="⌫" style="@style/KeypadButton" android:textColor="#FFFFFF" />

        </GridLayout>
    </LinearLayout>
</ScrollView>
